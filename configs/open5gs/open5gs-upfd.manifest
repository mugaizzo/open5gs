loader.argv = ["/var/tmp/open5gs/install/bin/open5gs-upfd", "-c", "/var/tmp/open5gs/configs/open5gs/upfraas.yaml", "-l", "/var/log/upf.log" ]
#loader.log_level = "debug"

fs.root =  "file:/"

fs.mounts = [
{ path = "/var/tmp/open5gs/install/bin/open5gs-upfd", uri = "file:/var/tmp/open5gs/install/bin/open5gs-upfd" },
{ path = "/var/tmp/open5gs/configs/open5gs/upfraas.yaml", uri = "file:/var/tmp/open5gs/configs/open5gs/upfraas.yaml" },
