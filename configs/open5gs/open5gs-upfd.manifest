fs.insecure__allow_all_ioctls = true

sys.allowed_ioctls = [
  # TUN/TAP device setup
  { request_code = 0x400454ca, struct = "ifreq" }, # TUNSETIFF
  { request_code = 0x400454cb, struct = "int"    }, # TUNSETPERSIST
  { request_code = 0x400454cc, struct = "int"    }, # TUNSETOWNER
  { request_code = 0x400454ce, struct = "int"    }, # TUNSETGROUP
  { request_code = 0x800454cf, struct = "int"    }, # TUNGETFEATURES

  # Network interface flags and addresses
  { request_code = 0x8913, struct = "ifreq" },     # SIOCGIFFLAGS
  { request_code = 0x8914, struct = "ifreq" },     # SIOCSIFFLAGS
  { request_code = 0x8915, struct = "ifreq" },     # SIOCGIFADDR
  { request_code = 0x8916, struct = "ifreq" },     # SIOCSIFADDR
  { request_code = 0x8917, struct = "ifreq" },     # SIOCGIFDSTADDR
  { request_code = 0x8918, struct = "ifreq" },     # SIOCSIFDSTADDR
  { request_code = 0x891b, struct = "ifreq" },     # SIOCGIFNETMASK
  { request_code = 0x891c, struct = "ifreq" },     # SIOCSIFNETMASK
  { request_code = 0x8922, struct = "ifreq" },     # SIOCSIFMTU
  { request_code = 0x8921, struct = "ifreq" },     # SIOCGIFMTU

  # MAC / HW address
  { request_code = 0x8927, struct = "ifreq" },     # SIOCSIFHWADDR
  { request_code = 0x8928, struct = "ifreq" },     # SIOCGIFHWADDR

  # Interface index
  { request_code = 0x8933, struct = "ifreq" },     # SIOCGIFINDEX

  # Interface name by index (optional but useful)
  { request_code = 0x8930, struct = "ifreq" },     # SIOCGIFNAME
]


sys.ioctl_structs.ifreq = [
{ size = 40, direction = "inout" },
]


fs.insecure__allow_device = true
fs.insecure__allow_socket = true



sys.allowed_syscalls = [
"practl",
"rseq",
"arch_prctl"
]

